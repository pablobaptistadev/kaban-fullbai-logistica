# Copia para .env.local e preenche (não commitar .env.local).
# O esquema SQL está em database/schema.sql.
#
# Estes dois valores são públicos por natureza: vão no bundle do browser.
# O que protege os dados são as policies de RLS, que prendem cada linha ao
# auth.uid() da sessão — sem login não se lê nem escreve nada.
VITE_SUPABASE_URL=https://pkguzxondqjockzsgpzn.supabase.co
# Dashboard → Project Settings → API Keys → anon / public
VITE_SUPABASE_ANON_KEY=
